from collections import deque

def solution(order):
    answer = 0
    n = 1
    con = []
    
    for o in order:
        while n < o:
            con.append(n)
            n += 1
        if n == o:
            n += 1
            answer += 1
            continue
        if con.pop() == o:
            answer += 1
            continue
        break
            
    return answer
